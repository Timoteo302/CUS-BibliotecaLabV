Cada LibroPrestamo tiene un préstamo: private Prestamo prestamosId;
Cada préstamo tiene un socio: private Socio socio;

Entonces: SELECT lp
FROM LibroPrestamo lp
WHERE lp.prestamosId.socio.dni = :dni


DAO:
public List<LibroPrestamo> buscarPorDniSocio(String dni){

    String jpql =
    "SELECT lp FROM LibroPrestamo lp "
    + "WHERE lp.prestamosId.socio.dni = :dni";


    return em.createQuery(jpql, LibroPrestamo.class)
            .setParameter("dni", dni)
            .getResultList();
}


