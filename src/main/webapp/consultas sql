=========  6.2 Buscar préstamos vencidos
public List<Prestamo> prestamosVencidos(){

    String jpql =
    "SELECT p FROM Prestamo p "
    + "WHERE p.fechaDevolucion IS NULL "
    + "AND p.fechaLimite < CURRENT_DATE";


    return em.createQuery(jpql, Prestamo.class)
            .getResultList();
}



