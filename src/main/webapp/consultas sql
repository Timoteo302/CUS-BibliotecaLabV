=========  9. BUSCAR SOCIO POR DNI O NOMBRE AL MISMO TIEMPO
public List<LibroPrestamo> buscarPorSocio(String dato){

    String jpql =
    "SELECT lp FROM LibroPrestamo lp "
    + "WHERE lp.prestamosId.socio.dni LIKE :dato "
    + "OR LOWER(lp.prestamosId.socio.nombres) LIKE LOWER(:dato)";


    return em.createQuery(jpql, LibroPrestamo.class)
            .setParameter("dato", "%" + dato + "%")
            .getResultList();
}

