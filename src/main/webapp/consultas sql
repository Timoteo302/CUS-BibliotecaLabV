=========  1. Buscar libros por autor
Libro:
Collection<Autor> autores;

Consulta:
public List<Libro> buscarPorAutor(String nombre){

    String jpql =
    "SELECT l FROM Libro l JOIN l.autores a "
    + "WHERE LOWER(a.nombre) LIKE LOWER(:nombre)";


    return em.createQuery(jpql, Libro.class)
            .setParameter("nombre","%" + nombre + "%")
            .getResultList();
}


=========  1.1 Buscar AUTORES DE UN LIBRO
public List<Autor> buscarAutoresDeLibro(String titulo){

    String jpql =
    "SELECT a FROM Libro l "
    + "JOIN l.autores a "
    + "WHERE l.titulo = :titulo";


    return em.createQuery(jpql, Autor.class)
            .setParameter("titulo", titulo)
            .getResultList();
}


=========  2. Buscar socio por DNI
public Socio buscarPorDni(String dni){

    String jpql = "SELECT s FROM Socio s WHERE s.dni = :dni";

    List<Socio> lista = em.createQuery(jpql, Socio.class)
            .setParameter("dni", dni)
            .getResultList();

    Socio socio = null;

    if(!lista.isEmpty()){
        socio = lista.get(0);
    }

    return socio;
}


